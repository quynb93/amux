{
  "name": "amux",
  "version": "0.1.0",
  "description": "Run Claude Code, Codex, Gemini CLI and other agent CLIs with many accounts over one shared home: skills, plugins, settings and sessions are shared, only the login differs.",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "gemini",
    "cli",
    "multi-account",
    "ai-agents"
  ],
  "homepage": "https://github.com/quynb93/amux#readme",
  "bugs": {
    "url": "https://github.com/quynb93/amux/issues"
  },
  "repository": "github:quynb93/amux",
  "license": "MIT",
  "author": "quynb93",
  "type": "module",
  "bin": {
    "amux": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "clean": "rm -rf dist .test-build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
